687 0 obj
  << /ActualText (\014asto zapom\355n\341me si uv\033domovat skute\015nou hodnotu lid\355 okolo sebe\056 O to v\355c tedy t\033ch\054 kteY\355 se staraj\355 o potYeby naa\355 spole\015nosti\056\240Pova\176ujeme je za prost\351 \036samozYejmosti\034 a fakt\054 \176e lid\351\054 je\176 tyto pr\341ce obvykle vykon\341vaj\355\054 patY\355 k nezraniteln\033ja\355m \015\341stem spole\015nosti\054 \372pln\033 opom\355j\355me\056 Nav\355c lidsk\341 mysl jakoby m\033la tendence zveli\015ovat sv\351 vlastn\355 probl\351my a komplikace\054 a pYitom zanedb\341vat a pohrdat nad ohromnou komplexitou osob kolem\056\n\240\nD\355ky moji pr\341ci v\240Albertu se mi naskytla pY\355le\176itost se spojit pr\341v\033 s\240takov\375mi lidmi a pohovoYit s nimi\056 Jejich v\375pov\033di se m\033 neskute\015n\033 dotkly a n\033kter\351 z\240nich pova\176uji za pYesn\341 zrcadla dnean\355 spole\015nosti\056 Ilustruj\355\054 jak naae spole\015nost a jej\355 takzvan\351 normy a tradice jsou zakoYen\033ny v\240nerovnosti\054 \372tlaku a chamtivosti\056\240 Z\341roveH vyzdvihuj\355 nedostatky naaeho soci\341ln\355ho st\341tu a probl\351my dan\351 prost\375mi vlastnostmi kapitalismu\056 Aby toho nebylo m\341lo \023 tak spole\015nost mezit\355m stav\355 tyto lidi\054 mimo\054 na stranu\056 M\355sto toho\054 aby na jejich probl\351my bylo nahl\355\176eno kolektivn\033\054 tak jsou \015astokr\341t odsuzov\341ny a zanech\341v\341ni bez jak\351koliv podpory\054 ae u\176 st\341tu tak lid\355 okolo sebe\056 Je to pr\341v\033 individualismus\054 kter\375 t\033mto lidem odep\355r\341 pomoc a vystavuje je na samou hranici sebez\341chovy\056\n\240\nWho\031s to blame\077\nNo one\054\nEveryone\056\n\240\nDo we have agency\077\nequal opportuninty is BS\n\240\nJ\341 z\240probl\351mo\054 s kter\375mi se tito lid\351 pot\375kaj\355\054 nevin\355m je sam\351\054 neY\355k\341m a nemysl\355m si\054 \176e mo\176ou za to\054 \176e se hold apatn\033 u\015ili\054 nechodili do akoly\054 moc se fl\341kali a dostali se do situace\054 kdy mus\355 dY\355t denn\033 v\240pr\341ci\054 jen aby se u\176ivili\056 To je blbost\056 Nem\033li toti\176 ani na v\375b\033r\046\240 Mo\176e za to spole\015nost \023 my vaichni\056 Skrz normalizaci a ignoranci d\033n\355 okolo sebe jsme si vytvoYili spole\015nost\054 ve kter\351 je absolutn\033 norm\341ln\355 tYeba podv\351st svou man\176elku\054 myslet o \176en\341ch podYadn\033 nebo napY\355klad \372pln\033 ignorovat zm\033nu klimatu\056 Pokrytectv\355 je v\240naaem spole\015enstv\355 a kultuYe zakoYen\033no hluboko\054 v\355ce\054 ne\176 si i dok\341\176eme n\033kdy pYiznat\056\n\240\nJan\054 \015tyYi a aedes\341ti let\375 zam\033stnanec ochrann\351 slu\176by Albertu\054 ilustruje tento probl\351m a\176 politov\341n\355hodn\033 pYesn\033\056 Na m\375ch sm\033n\341ch mi vypr\341v\355 o jeho rozmanit\351m \176ivot\033 \023 p\033t d\033t\355\054 dv\033 \176eny\054 n\033kolik povol\341n\355 od zedn\355ka po pracovn\355ka VeYejn\351 bezpe\015nosti\056 PYes pY\355b\033hy mi vytv\341Y\355 pYedstavu o tom\054 jak je sv\033t formov\341n kolem n\033ho\054 a j\341 zp\033tn\033\054 s\240nadhledem\054 si uv\033domuji\054 \176e on v\033tainou nem\033l jinou mo\176nost\054 a \176e nem\341m pr\341vo mu moc n\033co vy\015\355tat\056 \240Oproti tomu na pY\355kladu jeho prvn\355 \176eny\054 je\176 ho podv\341d\033la\054 kdy\176 se on odst\033hoval na \015as do ciziny\054 vid\355me pokrytectv\355 na pln\351 \015\341Ye\056 To\054 \176e on ji samotnou podvedl tak\351\054 ozna\015uje za norm\341ln\355 \036ale j\341 jsem pYece chlap\034\054 a o samotn\351 dost mo\176n\341 pY\355\015in\033 tohoto probl\351mu\054 \176e nebyl doma a de facto odeael od vztahu\054 ani nepom\375al\355\056 Kladu si ot\341zky\054 co je to za syst\351m\054 jen\176 mu vlo\176il takov\351hle zvyklosti\054 jak je mo\176n\351\054 \176e je tohle normalizovan\351\077 A pYece nejde h\341zet vaechnu vinu na n\033ho a myslet si o n\033m nejhora\355\054 kdy\176 on s\341m se prost\033 narodil do spole\015nosti\054 kde je toto normou\054 a nem\033l ani dovody o tom pochybovat\056\n\240\n)
     /K [ 2 ]
     /P 688 0 R
     /Pg 678 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

